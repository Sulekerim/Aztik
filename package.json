     gap: 15px;         }         .app-card {             background: rgba(0,0,0,0.3);             padding: 12px 18px;             border-radius: 14px;             transition: 0.2s;             border-left: 3px solid #ffb74d;         }         .app-card strong {             font-size: 1.2rem;             display: block;             margin-bottom: 6px;             color: #ffd966;         }         .app-card p {             font-size: 0.9rem;             opacity: 0.9;         }         .footer {             text-align: center;             margin-top: 40px;             padding: 20px;             font-size: 0.85rem;             border-top: 1px solid rgba(255,255,255,0.2);         }         @media (max-width: 700px) {             h1 { font-size: 1.8rem; }             .category h2 { font-size: 1.4rem; }             .apps-grid { grid-template-columns: 1fr; }         }     </style> </head> <body> <div class=\"container\">     <h1>📱 PROQRAM AZBEYSK</h1>     <div class=\"basliq-alt\">Bütün mövzularda ən yaxşı proqramlar – Reklam, Əyləncə, Oyun, Təhsil və daha çox</div>",
